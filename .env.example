# Copy this file to .env and fill in your own values. Never commit .env.
APP_NAME=doc-extractor-api
LOG_LEVEL=INFO

# LLM provider: openai | ollama (anthropic: not implemented yet)
# Examples: LLM_PROVIDER=openai + LLM_MODEL=gpt-4.1-mini
#           LLM_PROVIDER=ollama + LLM_MODEL=qwen2.5:3b (local, free)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120
OPENAI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
OLLAMA_BASE_URL=http://localhost:11434

# Async driver for the app; Alembic switches to psycopg (sync) for migrations.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Job queue (POST /jobs and the worker)
REDIS_URL=redis://localhost:6379/0

# Webhook called when a queued job finishes (optional). The body is signed with
# HMAC-SHA256 using WEBHOOK_SECRET: header X-Webhook-Signature: sha256=<hex>.
WEBHOOK_URL=
WEBHOOK_SECRET=change-me
